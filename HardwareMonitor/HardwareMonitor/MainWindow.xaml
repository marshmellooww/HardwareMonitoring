<Window x:Class="HardwareMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HardwareMonitor"
        mc:Ignorable="d"
        Title="Hardware Monitor"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Loaded="Window_Loaded"
        SizeChanged="Window_SizeChanged"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.Resources>
        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AAAAAA" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Dark context menu matching the overlay. -->
        <SolidColorBrush x:Key="MenuBackgroundBrush" Color="#F2202020" />
        <SolidColorBrush x:Key="MenuBorderBrush" Color="#33FFFFFF" />
        <SolidColorBrush x:Key="MenuHoverBrush" Color="#22FFFFFF" />
        <SolidColorBrush x:Key="MenuTextBrush" Color="#EEEEEE" />
        <SolidColorBrush x:Key="MenuMutedBrush" Color="#999999" />
        <SolidColorBrush x:Key="MenuAccentBrush" Color="#6CCB5F" />
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <Style x:Key="MenuIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource MenuMutedBrush}" />
        </Style>

        <Style TargetType="ContextMenu">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Margin="0,0,8,8"
                                Padding="3"
                                Background="{StaticResource MenuBackgroundBrush}"
                                BorderBrush="{StaticResource MenuBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.45" />
                            </Border.Effect>
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Margin="6,3" Background="{StaticResource MenuBorderBrush}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A menu row that just hosts its Header (used for the Hide/Exit buttons). -->
        <Style x:Key="MenuButtonRow" TargetType="MenuItem">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <ContentPresenter ContentSource="Header" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MenuRowButton" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Foreground" Value="{StaticResource MenuTextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Tag" Value="{StaticResource MenuHoverBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Padding="6,4" Background="Transparent" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Same as MenuRowButton, but hovers red to flag that it quits the app. -->
        <Style x:Key="MenuRowExitButton" TargetType="Button" BasedOn="{StaticResource MenuRowButton}">
            <Setter Property="Tag">
                <Setter.Value>
                    <SolidColorBrush Color="#40FF5A36" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Foreground" Value="{StaticResource MenuTextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="Bd" MinWidth="132" Padding="6,4" Background="Transparent" CornerRadius="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter x:Name="IconPresenter" ContentSource="Icon" VerticalAlignment="Center" />
                                    <TextBlock x:Name="CheckMark"
                                               Text="&#xE73E;"
                                               FontFamily="{StaticResource IconFont}"
                                               FontSize="10"
                                               Foreground="{StaticResource MenuAccentBrush}"
                                               VerticalAlignment="Center"
                                               Visibility="Collapsed" />
                                    <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
                                    <TextBlock x:Name="Arrow"
                                               Grid.Column="2"
                                               Margin="12,0,0,0"
                                               Text="&#xE76C;"
                                               FontFamily="{StaticResource IconFont}"
                                               FontSize="8"
                                               Foreground="{StaticResource MenuMutedBrush}"
                                               VerticalAlignment="Center"
                                               Visibility="Collapsed" />
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup"
                                   Placement="Right"
                                   HorizontalOffset="2"
                                   VerticalOffset="-5"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade"
                                   IsOpen="{TemplateBinding IsSubmenuOpen}">
                                <Border Margin="0,0,8,8"
                                        Padding="3"
                                        Background="{StaticResource MenuBackgroundBrush}"
                                        BorderBrush="{StaticResource MenuBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.45" />
                                    </Border.Effect>
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                                <Setter TargetName="IconPresenter" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="Role" Value="SubmenuHeader">
                                <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource MenuHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border x:Name="RootBorder"
            Background="#CC1A1A1A"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            CornerRadius="8"
            Padding="14,10">
        <Border.LayoutTransform>
            <ScaleTransform x:Name="ContentScale" ScaleX="1" ScaleY="1" />
        </Border.LayoutTransform>
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem x:Name="SensorsMenu" Header="Sensors">
                    <MenuItem.Icon>
                        <TextBlock Text="&#xE950;" Style="{StaticResource MenuIcon}" />
                    </MenuItem.Icon>
                    <!-- Tags match the Tag of the stat rows below. -->
                    <MenuItem Header="CPU" Tag="CPU" StaysOpenOnClick="True" Click="SensorMenuItem_Click" />
                    <MenuItem Header="CPU LOAD" Tag="CPU LOAD" StaysOpenOnClick="True" Click="SensorMenuItem_Click" />
                    <MenuItem Header="GPU" Tag="GPU" StaysOpenOnClick="True" Click="SensorMenuItem_Click" />
                    <MenuItem Header="GPU LOAD" Tag="GPU LOAD" StaysOpenOnClick="True" Click="SensorMenuItem_Click" />
                    <MenuItem Header="RAM" Tag="RAM" StaysOpenOnClick="True" Click="SensorMenuItem_Click" />
                    <MenuItem Header="VRAM" Tag="VRAM" StaysOpenOnClick="True" Click="SensorMenuItem_Click" />
                    <MenuItem Header="WIFI" Tag="WIFI" StaysOpenOnClick="True" Click="SensorMenuItem_Click" />
                    <MenuItem Header="IP" Tag="IP" StaysOpenOnClick="True" Click="SensorMenuItem_Click" />
                    <!-- Drive entries are appended in code, matching the drive rows. -->
                </MenuItem>
                <MenuItem x:Name="RefreshMenu" Header="Refresh rate">
                    <MenuItem.Icon>
                        <TextBlock Text="&#xE823;" Style="{StaticResource MenuIcon}" />
                    </MenuItem.Icon>
                    <MenuItem Header="1 second" Tag="1" Click="RefreshMenuItem_Click" />
                    <MenuItem Header="2 seconds" Tag="2" Click="RefreshMenuItem_Click" />
                    <MenuItem Header="3 seconds" Tag="3" Click="RefreshMenuItem_Click" />
                    <MenuItem Header="4 seconds" Tag="4" Click="RefreshMenuItem_Click" />
                    <MenuItem Header="5 seconds" Tag="5" Click="RefreshMenuItem_Click" />
                </MenuItem>
                <MenuItem Header="Layout">
                    <MenuItem.Icon>
                        <TextBlock Text="&#xE8A9;" Style="{StaticResource MenuIcon}" />
                    </MenuItem.Icon>
                    <MenuItem x:Name="VerticalLayoutItem" Header="Vertical" Click="LayoutMenuItem_Click" />
                    <MenuItem x:Name="HorizontalLayoutItem" Header="Horizontal" Click="LayoutMenuItem_Click" />
                </MenuItem>
                <MenuItem x:Name="SizeMenu" Header="Size">
                    <MenuItem.Icon>
                        <TextBlock Text="&#xE740;" Style="{StaticResource MenuIcon}" />
                    </MenuItem.Icon>
                    <MenuItem Header="Extra small" Tag="0.65" Click="SizeMenuItem_Click" />
                    <MenuItem Header="Small" Tag="0.85" Click="SizeMenuItem_Click" />
                    <MenuItem Header="Normal" Tag="1" Click="SizeMenuItem_Click" />
                    <MenuItem Header="Large" Tag="1.25" Click="SizeMenuItem_Click" />
                </MenuItem>
                <MenuItem x:Name="OpacityMenu" Header="Opacity">
                    <MenuItem.Icon>
                        <TextBlock Text="&#xE790;" Style="{StaticResource MenuIcon}" />
                    </MenuItem.Icon>
                    <MenuItem Header="100%" Tag="1" Click="OpacityMenuItem_Click" />
                    <MenuItem Header="85%" Tag="0.85" Click="OpacityMenuItem_Click" />
                    <MenuItem Header="70%" Tag="0.7" Click="OpacityMenuItem_Click" />
                    <MenuItem Header="50%" Tag="0.5" Click="OpacityMenuItem_Click" />
                </MenuItem>
                <Separator />
                <MenuItem x:Name="TopmostItem" Header="Always on top" Click="TopmostMenuItem_Click" />
                <MenuItem x:Name="LockPositionItem" Header="Lock position" Click="LockPositionMenuItem_Click" />
                <MenuItem x:Name="ClickThroughItem" Header="Click-through" Click="ClickThroughMenuItem_Click" />
                <MenuItem x:Name="StartWithWindowsItem" Header="Start with Windows" Click="StartWithWindowsMenuItem_Click" />
                <MenuItem Header="Reset position" Click="ResetPositionMenuItem_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="&#xE72C;" Style="{StaticResource MenuIcon}" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="Task Manager" Click="TaskManagerMenuItem_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="&#xE9D9;" Style="{StaticResource MenuIcon}" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <!-- Hide and Exit side by side, as buttons in a single menu row. -->
                <MenuItem Style="{StaticResource MenuButtonRow}">
                    <MenuItem.Header>
                        <UniformGrid Columns="2">
                            <Button Style="{StaticResource MenuRowButton}" Margin="0,0,2,0" Click="HideMenuItem_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xED1A;" Style="{StaticResource MenuIcon}" VerticalAlignment="Center" />
                                    <TextBlock Text="Hide" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource MenuRowExitButton}" Margin="2,0,0,0" Click="ExitMenuItem_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7E8;" Style="{StaticResource MenuIcon}" VerticalAlignment="Center" />
                                    <TextBlock Text="Exit" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                    </MenuItem.Header>
                </MenuItem>
            </ContextMenu>
        </Border.ContextMenu>

        <!-- Each stat is a label/value pair. Vertical layout stacks them and
             shares column widths so values line up; horizontal lays them out
             in a single row (see ApplyLayout). -->
        <StackPanel x:Name="StatsPanel" Grid.IsSharedSizeScope="True">
            <Grid Tag="CPU">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition SharedSizeGroup="Label" />
                    <ColumnDefinition SharedSizeGroup="Value" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="CPU" Style="{StaticResource LabelText}" />
                <TextBlock x:Name="CpuTempText" Grid.Column="1" Text="--°C" Style="{StaticResource ValueText}" />
            </Grid>
            <Grid Tag="CPU LOAD">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition SharedSizeGroup="Label" />
                    <ColumnDefinition SharedSizeGroup="Value" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="CPU LOAD" Style="{StaticResource LabelText}" />
                <TextBlock x:Name="CpuLoadText" Grid.Column="1" Text="--" Style="{StaticResource ValueText}" />
            </Grid>
            <Grid Tag="GPU">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition SharedSizeGroup="Label" />
                    <ColumnDefinition SharedSizeGroup="Value" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="GPU" Style="{StaticResource LabelText}" />
                <TextBlock x:Name="GpuTempText" Grid.Column="1" Text="--°C" Style="{StaticResource ValueText}" />
            </Grid>
            <Grid Tag="GPU LOAD">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition SharedSizeGroup="Label" />
                    <ColumnDefinition SharedSizeGroup="Value" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="GPU LOAD" Style="{StaticResource LabelText}" />
                <TextBlock x:Name="GpuLoadText" Grid.Column="1" Text="--" Style="{StaticResource ValueText}" />
            </Grid>
            <Grid Tag="RAM">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition SharedSizeGroup="Label" />
                    <ColumnDefinition SharedSizeGroup="Value" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="RAM" Style="{StaticResource LabelText}" />
                <TextBlock x:Name="RamText" Grid.Column="1" Text="--" Style="{StaticResource ValueText}" />
            </Grid>
            <Grid Tag="VRAM">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition SharedSizeGroup="Label" />
                    <ColumnDefinition SharedSizeGroup="Value" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="VRAM" Style="{StaticResource LabelText}" />
                <TextBlock x:Name="VramText" Grid.Column="1" Text="--" Style="{StaticResource ValueText}" />
            </Grid>
            <Grid Tag="WIFI">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition SharedSizeGroup="Label" />
                    <ColumnDefinition SharedSizeGroup="Value" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="WIFI" Style="{StaticResource LabelText}" />
                <TextBlock x:Name="WifiNameText" Grid.Column="1" Text="--" Style="{StaticResource ValueText}" />
            </Grid>
            <Grid Tag="IP">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition SharedSizeGroup="Label" />
                    <ColumnDefinition SharedSizeGroup="Value" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="IP" Style="{StaticResource LabelText}" />
                <TextBlock x:Name="WifiIpText" Grid.Column="1" Text="--" Style="{StaticResource ValueText}" />
            </Grid>
            <!-- One row per drive (DISK C, DISK D, ...) is added in code; see SyncDiskRows. -->
        </StackPanel>
    </Border>
</Window>
